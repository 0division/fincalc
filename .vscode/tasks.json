{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run fincalc",
      "type": "npm",
      "script": "start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "fincalc-server",
        "pattern": {
          "regexp": "^(.*):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> .* start",
          "endsPattern": "^Serving HTTP on .* port 8000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
