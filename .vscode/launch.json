{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch fincalc",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:debug",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "Serving HTTP on .* port ([0-9]+)",
        "uriFormat": "http://localhost:%s/"
      }
    }
  ]
}
